# Configuração do atendimento por voz (copie para .env e ajuste)
VOZ_HOST=127.0.0.1
VOZ_PORT=8088
VOZ_DB_PATH=./data/ocorrencias.db

# LLM (opcional). Sem chave, o agente usa a heurística local.
VOZ_LLM_ENABLED=true
VOZ_LLM_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=

# Parâmetros de atendimento
VOZ_MAX_CALL_SECONDS=600
VOZ_AUDIO_RETENTION_DAYS=90
VOZ_RECORDING_ENABLED=true
